{
  "name": "@actagent/google-meet",
  "version": "2026.6.3",
  "description": "ACTAgent Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/actagent/actagent"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@actagent/plugin-sdk": "workspace:*",
    "actagent": "workspace:*"
  },
  "peerDependencies": {
    "actagent": "workspace:*"
  },
  "peerDependenciesMeta": {
    "actagent": {
      "optional": true
    }
  },
  "actagent": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@actagent/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.6.2"
    },
    "build": {
      "actagentVersion": "2026.6.2"
    },
    "release": {
      "publishToACTAgentHub": true,
      "publishToNpm": true
    }
  }
}
