{
  "name": "@actagent/copilot",
  "version": "2026.6.3",
  "description": "ACTAgent GitHub Copilot agent runtime plugin (registers a `github-copilot` AgentHarness backed by @github/copilot-sdk over JSON-RPC to the GitHub Copilot CLI)",
  "repository": {
    "type": "git",
    "url": "https://github.com/actagent/actagent"
  },
  "type": "module",
  "dependencies": {
    "@github/copilot-sdk": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@github/copilot": "1.0.55",
    "@actagent/plugin-sdk": "workspace:*"
  },
  "actagent": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "actagenthubSpec": "actagenthub:@actagent/copilot",
      "npmSpec": "@actagent/copilot",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.6.2"
    },
    "build": {
      "actagentVersion": "2026.6.2",
      "bundledDist": false
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToACTAgentHub": true,
      "publishToNpm": true
    }
  }
}
