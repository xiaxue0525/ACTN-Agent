{
  "entries": [
    {
      "name": "@actagent/acpx",
      "description": "ACTAgent ACP runtime backend",
      "source": "official",
      "kind": "plugin",
      "actagent": {
        "plugin": {
          "id": "acpx",
          "label": "ACPX Runtime"
        },
        "install": {
          "npmSpec": "@actagent/acpx",
          "defaultChoice": "npm",
          "minHostVersion": ">=2026.4.25"
        }
      }
    },
    {
      "name": "@actagent/brave-plugin",
      "description": "ACTAgent Brave plugin",
      "source": "official",
      "kind": "plugin",
      "actagent": {
        "plugin": {
          "id": "brave",
          "label": "Brave"
        },
        "webSearchProviders": [
          {
            "id": "brave",
            "label": "Brave Search",
            "hint": "Brave Search web results.",
            "onboardingScopes": ["text-inference"],
            "credentialLabel": "Brave Search API key",
            "envVars": ["BRAVE_API_KEY"],
            "placeholder": "BSA...",
            "signupUrl": "https://api-dashboard.search.brave.com/app/keys",
            "docsUrl": "https://docs.actagent.ai/tools/brave-search",
            "credentialPath": "plugins.entries.brave.config.webSearch.apiKey",
            "autoDetectOrder": 10
          }
        ],
        "install": {
          "npmSpec": "@actagent/brave-plugin",
          "defaultChoice": "npm",
          "minHostVersion": ">=2026.4.10",
          "allowInvalidConfigRecovery": true
        }
      }
    },
